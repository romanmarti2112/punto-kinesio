---
import Icon from './Icon.astro';
import { business } from '../data/business';
import { mapsUrl, primaryWhatsApp } from '../lib/links';

const { location } = business;

// Ilustración: la cuadrícula del centro de Mendoza con sus cinco plazas.
const step = 40;
const lines = Array.from({ length: 15 }, (_, i) => 20 + i * step);
const plazas = [
  { x: 260, y: 260, s: 80 },
  { x: 140, y: 140, s: 40 },
  { x: 420, y: 140, s: 40 },
  { x: 140, y: 420, s: 40 },
  { x: 420, y: 420, s: 40 },
];
---

<section class="loc section" id="ubicacion" aria-labelledby="loc-title">
  <div class="loc__grid container">
    <div class="loc__text">
      <p class="eyebrow" data-reveal>
        <span class="num">07</span> Ubicación
      </p>
      <h2 id="loc-title" class="title" data-reveal style="--d: 80ms">
        Encontranos en <em>{location.city}.</em>
      </h2>

      <dl class="loc__info" data-reveal style="--d: 140ms">
        <div>
          <dt>Ciudad</dt>
          <dd>
            {location.city}, {location.country}
          </dd>
        </div>
        <div>
          <dt>Dirección</dt>
          <dd>
            {location.street ?? (
              <>
                Consultala por{' '}
                <a class="link-line" href={primaryWhatsApp} target="_blank" rel="noopener">
                  WhatsApp
                </a>
              </>
            )}
          </dd>
        </div>
      </dl>

      <div class="loc__actions" data-reveal style="--d: 200ms">
        <a class="btn" href={mapsUrl} target="_blank" rel="noopener">
          <Icon name="pin" />
          Cómo llegar
        </a>
      </div>
    </div>

    <figure class="loc__map" data-reveal="scale" aria-hidden="true">
      <svg viewBox="0 0 600 600" preserveAspectRatio="xMidYMid slice">
        <rect width="600" height="600" class="map-bg"></rect>
        <g class="map-streets">
          {lines.map((p) => (
            <line x1={p} y1="0" x2={p} y2="600" />
          ))}
          {lines.map((p) => (
            <line x1="0" y1={p} x2="600" y2={p} />
          ))}
        </g>
        <line class="map-avenue" x1="0" y1="220" x2="600" y2="220"></line>
        <line class="map-avenue" x1="380" y1="0" x2="380" y2="600"></line>
        <g class="map-plazas">
          {plazas.map((p) => (
            <rect x={p.x} y={p.y} width={p.s} height={p.s} />
          ))}
        </g>
      </svg>
      <div class="loc__pin">
        <span class="pulse"></span>
        <span class="pulse p2"></span>
        <svg viewBox="0 0 24 32">
          <path d="M12 0C5.4 0 0 5.3 0 11.8 0 20.4 12 32 12 32s12-11.6 12-20.2C24 5.3 18.6 0 12 0Z"></path>
          <circle cx="12" cy="11.6" r="6.6" fill="#f6f3ee"></circle>
          <circle cx="12" cy="11.6" r="4" fill="#0b6fb3"></circle>
        </svg>
      </div>
      <figcaption class="loc__coords">
        {location.city} · {location.cityCoordinates}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .loc {
    background: var(--paper-2);
  }

  .loc__grid {
    display: grid;
    gap: 3rem;
  }

  .loc__text {
    display: grid;
    gap: 1.75rem;
    align-content: center;
    justify-items: start;
  }

  .loc__info {
    display: grid;
    width: 100%;
    border-top: 1px solid var(--line);
  }

  .loc__info div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .loc__info dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.2rem;
  }

  .loc__info dd {
    font-weight: 600;
  }

  .loc__map {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--paper);
  }

  .loc__map > svg {
    width: 100%;
    height: 100%;
  }

  .map-bg {
    fill: var(--paper);
  }

  .map-streets line {
    stroke: rgb(14 20 25 / 0.1);
    stroke-width: 1;
  }

  .map-avenue {
    stroke: rgb(11 111 179 / 0.35);
    stroke-width: 3;
  }

  .map-plazas rect {
    fill: rgb(11 111 179 / 0.1);
    stroke: rgb(11 111 179 / 0.3);
  }

  .loc__pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3.25rem;
    transform: translate(-50%, -88%);
  }

  .loc__pin svg {
    position: relative;
    width: 100%;
    fill: var(--ink);
    filter: drop-shadow(0 8px 10px rgb(14 20 25 / 0.2));
  }

  .pulse {
    position: absolute;
    left: 50%;
    bottom: -0.5rem;
    width: 5rem;
    aspect-ratio: 1;
    margin-left: -2.5rem;
    margin-bottom: -2.5rem;
    border-radius: 50%;
    border: 1.5px solid var(--blue);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: pulse 3s var(--ease) infinite;
    }
    .p2 {
      animation-delay: 1.5s;
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(0.2);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .loc__coords {
    position: absolute;
    left: 1.25rem;
    bottom: 1.1rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .loc__map {
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 1024px) {
    .loc__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: center;
    }
    .loc__text {
      grid-column: 1 / span 5;
    }
    .loc__map {
      grid-column: 7 / -1;
      aspect-ratio: 1 / 1.05;
    }
  }
</style>
