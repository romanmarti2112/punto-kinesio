---
import Icon from './Icon.astro';
import { primaryWhatsApp } from '../lib/links';
---

<a
  class="wa-float"
  href={primaryWhatsApp}
  target="_blank"
  rel="noopener"
  aria-label="Consultar por un turno en WhatsApp"
>
  <span class="wa-float__tip" aria-hidden="true">
    ¿Consultás por un turno?
  </span>
  <span class="wa-float__btn">
    <Icon name="whatsapp" />
  </span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .wa-float__btn {
    position: relative;
    width: 3.6rem;
    height: 3.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--wa);
    color: var(--white);
    box-shadow: 0 10px 24px -8px rgb(14 20 25 / 0.45);
    transition: transform 0.45s var(--ease);
  }

  .wa-float__btn :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
  }

  /* Anillo que late dos veces al cargar para indicar que está ahí */
  .wa-float__btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--wa);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wa-float__btn::after {
      animation: ring 2s var(--ease) 1.2s 2;
    }
  }

  @keyframes ring {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  .wa-float__tip {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .wa-float__tip {
      display: block;
      padding: 0.6rem 0.95rem;
      background: var(--ink);
      color: var(--paper);
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
      border-radius: 999px;
      opacity: 0;
      transform: translateX(0.5rem);
      pointer-events: none;
      transition:
        opacity 0.3s,
        transform 0.4s var(--ease);
    }

    .wa-float:hover .wa-float__tip,
    .wa-float:focus-visible .wa-float__tip {
      opacity: 1;
      transform: none;
    }

    .wa-float:hover .wa-float__btn {
      transform: scale(1.08);
    }
  }

  :global(.menu-open) .wa-float {
    opacity: 0;
    pointer-events: none;
  }
</style>
