---
/**
 * Logotipo: pin + "punto·kinesio". Reproduce la identidad del logo original
 * en código (nítido en cualquier tamaño). Reemplazable por el SVG oficial.
 */
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`, className]}>
  <svg class="logo__pin" viewBox="0 0 24 32" aria-hidden="true">
    <path
      class="logo__pin-body"
      d="M12 0C5.4 0 0 5.3 0 11.8 0 20.4 12 32 12 32s12-11.6 12-20.2C24 5.3 18.6 0 12 0Z"
    ></path>
    <circle class="logo__pin-ring" cx="12" cy="11.6" r="6.6"></circle>
    <circle class="logo__pin-dot" cx="12" cy="11.6" r="4"></circle>
  </svg>
  <span class="logo__word">
    punto<i aria-hidden="true"></i>
    <span>kinesio</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    line-height: 1;
  }

  .logo__pin {
    width: 1.05em;
    height: 1.4em;
    flex: none;
    transform: translateY(-0.08em);
  }

  .logo__pin-body {
    fill: var(--ink);
  }
  .logo__pin-ring {
    fill: var(--paper);
  }
  .logo__pin-dot {
    fill: var(--blue);
  }

  .logo__word {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.32em;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .logo__word i {
    width: 0.3em;
    height: 0.3em;
    margin-inline: 0.06em 0.05em;
    border-radius: 50%;
    background: var(--ink);
    align-self: center;
    transform: translateY(0.12em);
  }

  .logo__word span {
    color: var(--blue);
  }

  .logo--light .logo__pin-body,
  .logo--light .logo__word i {
    fill: var(--paper);
    background: var(--paper);
  }
  .logo--light .logo__pin-ring {
    fill: var(--ink);
  }
  .logo--light .logo__word {
    color: var(--paper);
  }
  .logo--light .logo__word span {
    color: #5fb0e6;
  }
</style>
