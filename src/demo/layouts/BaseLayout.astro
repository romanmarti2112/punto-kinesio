---
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../../styles/global.css';

import SEO from '../components/SEO.astro';
import { business } from '../data/business';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang={business.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f3ee" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='30' fill='%23fff' stroke='%231f4fe0' stroke-width='8'/%3E%3Ccircle cx='32' cy='32' r='10' fill='%231f4fe0'/%3E%3C/svg%3E" />

    <SEO title={title} description={description} />

    <!-- Marca que hay JS antes de pintar: evita parpadeos en las animaciones de entrada -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="demo-badge">Demo de concepto · Viña Studio</div>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
    <script>
      import '../../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  .demo-badge {
    position: fixed; left: 12px; bottom: 12px; z-index: 200; pointer-events: none;
    font: 700 11px/1 sans-serif; letter-spacing: .08em; text-transform: uppercase;
    background: rgba(0, 0, 0, .8); color: #fff; padding: 8px 12px; border-radius: 99px;
  }
</style>
